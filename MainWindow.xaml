<Window
    x:Class="SSVidPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SSVidPlayer">

	<Window.SystemBackdrop>
		<MicaBackdrop />
	</Window.SystemBackdrop>

	<Grid Background="Black" RequestedTheme="Dark">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Grid x:Name="AppTitleBar" Grid.Row="0" Height="32" Background="Black">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			<Image x:Name="AppIconImage" Width="16" Height="16" Margin="12,0,8,0" VerticalAlignment="Center"/>
			<TextBlock Text="SSVidPlayer" Foreground="#55FF00" FontSize="12" VerticalAlignment="Center" Grid.Column="1"/>
		</Grid>

		<WebView2 x:Name="PlayerWebView" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
	</Grid>
</Window>