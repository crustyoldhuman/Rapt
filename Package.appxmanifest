<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

	<Identity    Name="crustyoldhuman.RaptVideoPlayer"    Publisher="CN=B6D2EA96-72C0-489A-B1AB-D0B04A7E7493"    Version="1.3.1.0" />
	<mp:PhoneIdentity PhoneProductId="d12293f0-a8f6-415d-a918-28adaea0b4e7" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>
	<Properties>
		<DisplayName>Rapt Video Player</DisplayName>
		<PublisherDisplayName>crustyoldhuman</PublisherDisplayName>
		<Logo>Assets\StoreLogo.png</Logo>
	</Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26226.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26226.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
		<uap:VisualElements
		  DisplayName="Rapt Video Player"
		  Description="Rapt Video Player"
		  BackgroundColor="transparent"
		  Square150x150Logo="Assets\Square150x150Logo.png"
		  Square44x44Logo="Assets\Square44x44Logo.png">
			<uap:DefaultTile ShortName="Rapt" Wide310x150Logo="Assets\Wide310x150Logo.png"  Square71x71Logo="Assets\SmallTile.png" Square310x310Logo="Assets\LargeTile.png"/>
		  <uap:SplashScreen Image="Assets\SplashScreen.png" />
	  </uap:VisualElements>
		<Extensions>
			<uap:Extension Category="windows.fileTypeAssociation">
				<uap:FileTypeAssociation Name="video">
					<uap:SupportedFileTypes>
						<uap:FileType>.mp4</uap:FileType>
						<uap:FileType>.mkv</uap:FileType>
						<uap:FileType>.webm</uap:FileType>
						<uap:FileType>.mov</uap:FileType>
						<uap:FileType>.m4v</uap:FileType>
						<uap:FileType>.avi</uap:FileType>
					</uap:SupportedFileTypes>
				</uap:FileTypeAssociation>
			</uap:Extension>
			<uap:Extension Category="windows.fileTypeAssociation">
				<uap:FileTypeAssociation Name="audio">
					<uap:SupportedFileTypes>
						<uap:FileType>.mp3</uap:FileType>
						<uap:FileType>.wav</uap:FileType>
						<uap:FileType>.m4a</uap:FileType>
						<uap:FileType>.flac</uap:FileType>
						<uap:FileType>.aac</uap:FileType>
						<uap:FileType>.ogg</uap:FileType>
					</uap:SupportedFileTypes>
				</uap:FileTypeAssociation>
			</uap:Extension>
			<uap:Extension Category="windows.fileTypeAssociation">
				<uap:FileTypeAssociation Name="subtitles">
					<uap:SupportedFileTypes>
						<uap:FileType>.srt</uap:FileType>
						<uap:FileType>.vtt</uap:FileType>
						<uap:FileType>.ass</uap:FileType>
					</uap:SupportedFileTypes>
				</uap:FileTypeAssociation>
			</uap:Extension>
		</Extensions>
  </Application>
</Applications>

	<Capabilities>
		<Capability Name="internetClient" />
		<rescap:Capability Name="runFullTrust" />
	</Capabilities>
</Package>
